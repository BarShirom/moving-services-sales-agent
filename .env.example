OPENAI_API_KEY=
OPENAI_MODEL=

# Local defaults. For Docker, override NODE_ENV=production at runtime.
PORT=3001
NODE_ENV=development
# Optional exact browser origin (no trailing slash); blank preserves same-origin behavior.
CLIENT_ORIGIN=
# Canonical external HTTPS origin for production behind an HTTPS reverse proxy.
# Blank locally; e.g. https://demo.example.com in deployment configuration.
DEMO_PUBLIC_ORIGIN=

# Blank for direct local development. Compose sets only Caddy's exact private IP.
# Requires production Secure cookies, HTTPS DEMO_PUBLIC_ORIGIN and blank CLIENT_ORIGIN.
# Never use a CIDR, hostname, hop count, or public visitor address.
DEMO_TRUSTED_PROXY_IP=

# Public demo protection. Invalid values fail startup. See deploy/Caddyfile for proxy admission.
# Minute/hour quotas use fixed windows starting with the first attempt.
DEMO_SESSION_REQUESTS_PER_MINUTE=60
DEMO_CLIENT_REQUESTS_PER_MINUTE=120
DEMO_GLOBAL_REQUESTS_PER_MINUTE=300
DEMO_CLIENT_SESSIONS_PER_HOUR=5
DEMO_GLOBAL_SESSIONS_PER_HOUR=30
DEMO_MAX_TRACKED_CLIENTS=1000
# AI has no waiting queue. Session reset does not reset these counters.
DEMO_AI_CONCURRENCY=2
DEMO_AI_REQUESTS_PER_SESSION=20
DEMO_AI_REQUESTS_PER_CLIENT_HOUR=30
DEMO_AI_REQUESTS_PER_MINUTE=10
# UTC-day cutoff. Zero daily requests or reserved tokens disables paid extraction.
DEMO_AI_REQUESTS_PER_DAY=100
DEMO_AI_RESERVED_TOKENS_PER_DAY=2000000
DEMO_AI_MAX_REQUEST_BYTES=196608
